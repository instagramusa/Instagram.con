* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
    background-color: #fafafa;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container {
    width: 100%;
    max-width: 350px;
    padding: 20px;
}

.content {
    background-color: white;
    border: 1px solid #dbdbdb;
    border-radius: 3px;
    padding: 10px 0;
    margin-bottom: 10px;
}

.login-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 20px;
    padding: 0 40px;
}

.logo-img {
    width: 175px;
    margin: 20px 0;
}

form {
    display: flex;
    flex-direction: column;
    width: 100%;
}

input {
    height: 38px;
    border: 1px solid #dbdbdb;
    border-radius: 3px;
    padding: 0 10px;
    margin-bottom: 6px;
    font-size: 12px;
    background-color: #fafafa;
}

input:focus {
    outline: none;
    border: 1px solid #8e8e8e;
}

.login-button {
    background-color: #0095f6;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px;
    font-weight: 600;
    margin-top: 8px;
    cursor: pointer;
    font-size: 14px;
}

.login-button:disabled {
    background-color: #b2dffc;
}

.divider {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 20px 0;
}

.line {
    flex-grow: 1;
    height: 1px;
    background-color: #dbdbdb;
}

.divider span {
    margin: 0 15px;
    color: #8e8e8e;
    font-size: 13px;
}

.facebook-login {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    cursor: pointer;
}

.facebook-login img {
    width: 16px;
    margin-right: 8px;
}

.facebook-login span {
    color: #385185;
    font-weight: 600;
    font-size: 14px;
}

.forgot-password {
    color: #00376b;
    font-size: 12px;
    margin-top: 12px;
}

.signup-box {
    background-color: white;
    border: 1px solid #dbdbdb;
    border-radius: 3px;
    padding: 20px;
    text-align: center;
    font-size: 14px;
}

.signup-box a {
    color: #0095f6;
    font-weight: 600;
}

.app-download {
    text-align: center;
    margin-top: 20px;
}

.app-download p {
    font-size: 14px;
    margin-bottom: 10px;
}

.app-buttons {
    display: flex;
    justify-content: center;
    gap: 8px;
}

.app-buttons img {
    height: 40px;
}
